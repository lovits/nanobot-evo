{
  "providers": {
    "agnes": {
      "apiKey": "${AGNES_API_KEY}",
      "apiBase": "https://apihub.agnes-ai.com/v1"
    }
  },
  "modelPresets": {
    "primary": {
      "label": "Agnes 2.0 Flash",
      "provider": "agnes",
      "model": "agnes-2.0-flash",
      "maxTokens": 8192,
      "contextWindowTokens": 262144,
      "temperature": 0.1
    }
  },
  "agents": {
    "defaults": {
      "modelPreset": "primary"
    }
  }
}
